default_platform(:ios)

platform :ios do
  desc "Build a signed release and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_BASE64"),
      is_key_content_base64: true
    )

    build_app(
      project: "News App.xcodeproj",
      scheme: "News App",
      clean: true,
      export_method: "app-store",
      xcconfig: "Config/Secrets.xcconfig",
      export_options: {
        provisioningProfiles: {
          "in.sachinserver.News-App" => ENV.fetch("PROVISIONING_PROFILE_NAME")
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
